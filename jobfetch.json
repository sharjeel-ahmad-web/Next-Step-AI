                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"lat\": {{lat}},\n  \"lng\": {{lng}}\n}"
                },
                "url": "{{base_url}}/profile/location"
            }
        },
        {
